\subtree{
  \title{Decision}
  \p{Sealed constants are \code{opaque} or \code{irreducible} (→ D-RT-13), so elaboration never unfolds them; instance search depth is capped and every class in the interface is a \code{Prop}-class or a \code{structure} carried explicitly; \code{Space} data is never pattern- matched in \code{Theory/}; large presheaf constructions in the kernel are \code{irreducible} with \code{simp} equations; \code{Fin}-combinatorics stays in the kernel behind \ref{at-kr-0003} presentations. Benchmarks are forest nodes updated in CI.}
}
\subtree{
  \title{Status}
  \p{provisional.}
}
