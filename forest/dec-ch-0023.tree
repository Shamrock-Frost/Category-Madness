\subtree{
  \title{Decision}
  \p{Separate object and hom universes in category APIs. Root label collections, entry types, and spaces of matrices are not required to occupy the same universe. Universe maxima and successor levels required by Lean are explicit (\ref{dec-rt-0027}).}
}
\subtree{
  \title{Rationale}
  \p{Large collections of small objects remain large collections.}
}
\subtree{
  \title{Rejected}
  \p{Using augmentation or \code{ULift} as universe lowering.}
}
\subtree{
  \title{Acceptance}
  \p{\ref{at-fd-0001}.}
}
\subtree{
  \title{Status}
  \p{frozen policy; concrete signatures validated at \ref{ms-foundation}.}
}
