\subtree{
  \title{Decision}
  \p{A tactic/command for Kan extension along shape inclusions: given \code{i : J → J'} between shapes and \code{F : N J → C}, produces the pointwise extension statement (limits over slices \code{(j' ↓ i)}), discharges existence from \code{HasLimitsOfShape} hypotheses, and names the witness. Specializations: \code{cosk_n}, \code{sk_n}, Čech (→ \ref{dec-up-0007}). This replaces the coherence tactic of biased designs (→ D-CH-03).}
}
\subtree{
  \title{Status}
  \p{frozen (existence), provisional (interface).}
}
