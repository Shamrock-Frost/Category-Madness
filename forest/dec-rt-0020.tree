\title{D-RT-20 · Truncation is an optional comparison}
\taxon{Decision}
\meta{id}{D-RT-20}
\meta{area}{root}
\meta{origin}{design/02-root.md}
\meta{status}{frozen}
\meta{status-text}{frozen removal of the unsupported requirement; general truncation later.}
