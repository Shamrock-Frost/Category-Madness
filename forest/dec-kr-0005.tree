\tag{decision}
\tag{area:kr}
\tag{status:superseded}

\subtree{
  \title{Decision}
  \p{Each shape category is equipped with a Reedy structure (degree, \code{Θ⁺} = monomorphisms/faces including active ones, \code{Θ⁻} = degeneracies/collapses). Planar shapes (Δ, Ω_p, Θ_fc, Θ_n, Δ×Δ) are expected to be \strong{elegant} Reedy categories (Bergner–Rezk: every presheaf's degenerate elements are uniquely degeneracies of non-degenerate ones; Reedy cofibrations are monomorphisms; every object is cofibrant). Ω has automorphisms and is a \strong{generalized Reedy} category in the sense of Berger–Moerdijk (EZ category); there the cofibrant objects are the \em{normal} presheaves and Reedy fibrancy involves \code{Aut}-equivariance. Labelled shape categories \code{Θ_{T,X}} (\ref{dec-kr-0007}) inherit the Reedy structure along the discrete fibration to \code{Θ_T}. Machinery: latching/matching objects, skeleta/coskeleta, the Reedy lemma for presheaves valued in \code{sSet}, Reedy fibrancy (→ D-RT-07).}
}
\subtree{
  \title{Acceptance}
  \p{\ref{at-kr-0006}: elegance of Δ, Ω_p, Θ^aug_fc \strong{(verify for Θ_fc; expected)}; \ref{at-kr-0007}: Ω is EZ/dualizable generalized Reedy.}
}
\subtree{
  \title{Status}
  \p{frozen (the list of which shapes are elegant is provisional until \ref{at-kr-0006}).}
}
