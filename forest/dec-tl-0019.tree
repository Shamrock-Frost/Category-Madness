\subtree{
  \title{Decision}
  \p{Use Kernel/, Root/, Interface/, Interface-Stub/, Theory/, Prototype/, Generated/, forest/, scripts/, and optional mcp/. \code{history/v0/} in this document bundle is archival and excluded from active decision/test indexing. Prototype/ results are promoted only with dependencies and validation made explicit.}
}
\subtree{
  \title{Rationale}
  \p{Experimental definitions should not accidentally become public foundations.}
}
