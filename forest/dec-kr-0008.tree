\subtree{
  \title{Decision}
  \ul{
    \li{Δ₊ (augmented simplices) with its join monoidal structure; joins and slices of simplicial sets (needed for → \ref{dec-up-0003}).}
    \li{Δ×Δ for double (non-virtual) structures; used when composites exist (→ \ref{dec-ft-0002}).}
    \li{Θ_n by Berger's wreath product, defined in \ref{ms-0001} and unused until (∞,n) work.}
    \li{Twisted-arrow-type shapes \code{Tw(θ)} for each \code{θ ∈ Θ_fc} (Barwick, Haugseng), in which the pullbacks of composable spans are objects; needed for \code{Span(S)} (→ \ref{dec-sp-0005}). Defined at \ref{ms-0001} with the others; their Segal theory is \ref{ms-0006}.}
    \li{The groupoids \code{Σ_A}, \code{𝔹_A}, \code{ℕ_A} of finite \code{A}-coloured sets with bijections, braids, and identities, as the indexing categories of symmetric, braided, and non-symmetric sequences (→ \ref{dec-sp-0009}).}
  }
}
