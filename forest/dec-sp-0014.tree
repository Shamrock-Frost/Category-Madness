\title{D-SP-14 · Spans and category objects in spaces}
\taxon{Decision}
\meta{id}{D-SP-14}
\meta{area}{spaces and enrichment}
\meta{origin}{design/05-spaces-enrichment.md}
\meta{status}{provisional}
