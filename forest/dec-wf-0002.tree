\subtree{
  \title{Decision}
  \p{Every \code{D-<AREA>-<nn>} in these documents becomes a tree with fields \em{decision, rationale, rejected alternatives, acceptance tests (refs), affected declarations (backlinks from \ref{dec-wf-0001}), status, supersedes/superseded-by, origin}. Statuses: \code{frozen}, \code{provisional}, \code{later}, \code{superseded}. Changing a \code{frozen} decision requires a new decision node that supersedes it; the old node is never edited. PRs must cite the decision nodes they rely on; CI checks that cited nodes exist and are not \code{superseded}.}
}
