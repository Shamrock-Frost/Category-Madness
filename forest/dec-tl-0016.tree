\subtree{
  \title{Decision}
  \p{An extension command states the relevant pointwise universal property, uses proved existence/coherence theorems, and names a witness. It does not invent an extension from a collection of pointwise choices. Its primary example is Čech \code{cosk₀}.}
}
\subtree{
  \title{Rationale}
  \p{The command packages a construction already justified by the interface.}
}
\subtree{
  \title{Rejected}
  \p{Closing coherence obligations solely by generated syntax.}
}
\subtree{
  \title{Acceptance}
  \p{\ref{at-up-0006} and \ref{at-up-0007}.}
}
\subtree{
  \title{Status}
  \p{provisional, \ref{ms-0004}.}
}
