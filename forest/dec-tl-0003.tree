\subtree{
  \title{Decision}
  \p{An attribute that, for a declaration about shapes/Segal categories/VDC∞s, generates the dual declaration by \code{op} on shapes and on ambient Segal categories, with a name translation table (\code{Limit ↔ Colimit}, \code{Terminal ↔ Initial}, \code{Ran ↔ Lan}, \code{companion ↔ conjoint}, \code{restriction ↔ extension} where applicable) — modelled on \code{to_additive}. No dual is ever written by hand (→ \ref{dec-up-0005}). Built at \ref{ms-0000}–\ref{ms-0001} against the shapes, extended at \ref{ms-0004}.}
}
\subtree{
  \title{Rationale}
  \p{The single highest-leverage tool Mathlib's category theory never had.}
}
\subtree{
  \title{Status}
  \p{frozen (existence), provisional (translation table).}
}
