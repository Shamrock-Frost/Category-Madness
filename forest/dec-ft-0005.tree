\subtree{
  \title{Decision}
  \p{An ∞-cosmos is defined as a category enriched in Segal categories (through the strict simplicial-category model, → \ref{dec-sp-0002}) with the Riehl–Verity limits and isofibrations, adapted to the Segal-category model; its homotopy 2-category and its virtual equipment of modules are compared with \code{hP} for \code{P = Mod(Mat Kan)} (\ref{at-ft-0009}).}
}
\subtree{
  \title{Status}
  \p{later (\ref{ms-0007}).}
}
