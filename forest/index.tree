    \li{\ref{ft-0000} — coherent formal category theory.}
    \li{\ref{sp-0000} — spaces, matrices, spans, and the profunctor symmetry track.}
    \li{\ref{tl-0000} — scoped generation, swap builds, and trust checks.}
