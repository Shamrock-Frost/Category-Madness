\subtree{
  \title{Decision}
  \p{An E1-monoidal Segal category is a Segal presheaf on Δ (unlabelled, one object) valued in Segal categories; \code{Mat(V)} for such \code{V} has cells as maps out of unbiased tensors; Gepner–Haugseng's comparison is the acceptance test.}
}
