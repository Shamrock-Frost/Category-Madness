\subtree{
  \title{Success criteria}
  \ol{
    \li{The swap test (→ \ref{dec-tl-0006}) is green: \code{Theory/} builds against a stub interface whose constants are bodiless axioms.}
    \li{The self-hosting theorem (→ \ref{at-rt-0001}) is proved: discrete VDC∞s are exactly set-level augmented virtual double categories, and the discrete \code{Category} is exactly the classical one.}
    \li{Yoneda, weighted limits, Kan extensions, adjunctions, and monads are each stated once for augmented virtual ∞-equipments (→ \ref{ft-0000}) and their discrete specializations coincide with Cruttwell–Shulman and Koudenburg (→ \ref{at-ft-0001}).}
    \li{Segal categories, i.e. monads in \code{Mat(Kan)}, are the ∞-categories of the library, with no separate definition (→ \ref{at-sp-0002}).}
  }
}
\subtree{
  \title{Glossary}
  \ul{
    \li{\strong{VDC∞} — virtual double ∞-category, the root object (→ \ref{dec-rt-0001}).}
    \li{\strong{Labelled} — objects are a set \code{X}; shapes carry labels in \code{X} at object positions.}
    \li{\strong{Augmented} — cells may have empty horizontal target (Koudenburg).}
    \li{\strong{E1} — inputs of cells are ordered; no symmetries at the root.}
    \li{\strong{Segal condition} — the value at a shape is the (homotopy) limit of values at its elementary sub-shapes.}
    \li{\strong{DK-equivalence} — Dwyer–Kan equivalence: essentially surjective and fully faithful, spelled out in → \ref{dec-rt-0006}.}
    \li{\strong{Sealed} — visible only through \code{Interface/}; unfolding forbidden by mechanism.}
    \li{\strong{Witness} — an inhabitant of \code{{x // universalProperty x}}.}
    \li{\strong{Acceptance test} — a Lean statement whose proof is evidence a definition is right.}
    \li{\strong{Shape} — an object of one of the kernel's shape categories (Δ, Ω_p, Θ_fc, …).}
  }
}
