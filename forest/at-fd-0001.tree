\title{AT-FD-1 · Universe signatures}
\taxon{Acceptance test}
\meta{id}{AT-FD-1}
\meta{area}{foundation feasibility}
\meta{origin}{design/11-foundation-feasibility.md}
\meta{status}{proved}
\meta{statement-version}{1}
\meta{evidence}{docs/foundations/README.md, docs/foundations/inventory.json, docs/foundations/signatures.md}
