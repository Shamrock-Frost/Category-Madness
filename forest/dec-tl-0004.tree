\subtree{
  \title{Decision}
  \p{A tactic that, given a goal mentioning a witness \code{L : Limit F} (or any \code{Terminal K}) and a second witness \code{L'}, rewrites along the canonical equivalence \code{L ≃ L'} using the functoriality lemmas registered by the \code{@[witness_functorial]} attribute (→ \ref{dec-up-0006}). Failure is loud: if no functoriality lemma is registered for a construction, the tactic reports which one is missing.}
}
\subtree{
  \title{Status}
  \p{frozen (existence), provisional (interface).}
}
