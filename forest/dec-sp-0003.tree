\subtree{
  \title{Decision}
  \p{Before general monoidal enrichment, only \em{cartesian} value categories are supported: \code{V = Set} (discrete) and \code{V = Kan}. Cells in \code{Mat(V)} are families of maps out of products. General E1-monoidal \code{V} is → \ref{dec-sp-0007}.}
}
