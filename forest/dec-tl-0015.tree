\tag{decision}
\tag{area:tl}
\tag{status:provisional}

\subtree{
  \title{Decision}
  \p{A witness-transport tactic uses registered functoriality lemmas on witness categories. It fails with the missing lemma when a construction has no justified transport. It never proves equality of arbitrary Lean witness terms from categorical uniqueness.}
}
\subtree{
  \title{Rationale}
  \p{The automation should expose missing mathematical structure.}
}
\subtree{
  \title{Rejected}
  \p{Rewriting all witnesses to a global chosen object by definition.}
}
\subtree{
  \title{Acceptance}
  \p{\ref{at-up-0001} and a nontrivial limit-witness client at \ref{ms-0004}.}
}
\subtree{
  \title{Status}
  \p{provisional, \ref{ms-0004}.}
}
