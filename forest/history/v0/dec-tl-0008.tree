\subtree{
  \title{Decision}
  \p{\code{Kernel/}, \code{Root/}, \code{Interface/}, \code{Interface-Stub/}, \code{Theory/{UP, FT, SP, …}}, \code{Generated/}, \code{forest/}, \code{scripts/}, \code{mcp/}. Declarations: \code{Structure.field_property}, snake_case theorems, dot notation, no abbreviations in names, statement-shaped names (\code{Limit.isTerminal_of_isTerminal}), theorems named for their conclusion. Subject to → \ref{dec-tl-0001}.}
}
