\subtree{
  \title{Decision}
  \p{For elegant shapes, there is a functorial Reedy-fibrant replacement of Segal presheaves that preserves the label set and is a levelwise homotopy equivalence on elementary values; for \code{Δ_X} this is Bergner's fibrant replacement for Segal categories. The kernel proves the version needed by → \ref{dec-rt-0007}.}
}
\subtree{
  \title{Rationale}
  \p{Natural examples (strict simplicial categories, \code{Mat(Kan)}) are Segal but not Reedy fibrant; derived mapping spaces need a fibrant target.}
}
\subtree{
  \title{Acceptance}
  \p{\ref{at-kr-0011}: replacement exists and is a DK-equivalence (→ \ref{dec-rt-0006}).}
}
\subtree{
  \title{Status}
  \p{provisional (proof strategy to be chosen at \ref{ms-0002}: Bergner-style small object argument along the elementary boundary inclusions is the default).}
}
