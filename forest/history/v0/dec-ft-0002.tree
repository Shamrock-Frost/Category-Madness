\tag{status:frozen}

\subtree{
  \title{Decision}
  \p{\code{P} \em{has composites} when for every path \code{(M₁,…,M_n)} there is a horizontal \code{M₁ ⊙ ⋯ ⊙ M_n} with an opcartesian \code{n}-ary cell. Then \code{P} restricted to the \code{Δ×Δ}-shapes (→ \ref{dec-kr-0008}) is a double ∞-category, and if \code{P} is an equipment it is an ∞-equipment in Ruit's sense \strong{(verify: this is the statement of \ref{at-ft-0004}; the precise notion of "Ruit's sense" transported to Segal-style double ∞-categories is part of the task)}. Composites are a property with witnesses, never structure (→ \ref{dec-ch-0002}).}
}
\subtree{
  \title{Acceptance}
  \p{\ref{at-ft-0004} as above; \ref{at-ft-0005}: \code{Cat} has composites (coends of profunctors) and the induced double category is the classical one.}
}
\subtree{
  \title{Status}
  \p{frozen at \ref{ms-0005}.}
}
