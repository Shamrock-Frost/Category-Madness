\subtree{
  \title{Decision}
  \p{Generated, never hand-edited: notation (\code{X ⟶ Y}, \code{f ≫ g} diagrammatic, \code{C ⥤ D}, \code{A ⇸ B}, \code{α ⇒ β}), binary \code{abbrev}s over unbiased primitives (\code{X ⨯[p] Y} over \code{Product}, \code{f ≫ g} over \code{compN}), docstring-derived forest nodes (→ \ref{dec-wf-0001}), and any "pretty" API. Regeneration is a CI step; a hand edit to a generated file fails CI.}
}
\subtree{
  \title{Rationale}
  \p{→ \ref{dec-ch-0007}. The human layer is a view.}
}
\subtree{
  \title{Status}
  \p{provisional (mechanism frozen, contents provisional).}
}
